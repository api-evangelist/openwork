{
  "opencollection": "1.0.0",
  "info": {
    "name": "Den Admin API Keys API",
    "version": "dev"
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organization API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openworklabs.com/v1/api-keys",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the API keys that belong to the selected organization."
        }
      ]
    }
  ],
  "bundled": true
}