        },
        {
          "info": {
            "name": "Get plugin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openworklabs.com/v1/plugins/:pluginId",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "path",
                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
              }
            ]
          },
          "docs": "Returns one plugin detail when the caller can view it."
        },
        {
          "info": {
            "name": "Update plugin",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.openworklabs.com/v1/plugins/:pluginId",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "path",
                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates plugin metadata."
        },
        {
          "info": {
            "name": "archive plugin",
            "type": "http"
