            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or reactivates one access grant for a plugin."
        },
        {
          "info": {
            "name": "Revoke plugin access",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.openworklabs.com/v1/plugins/:pluginId/access/:grantId",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "path",
                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
