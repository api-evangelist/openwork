                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
              }
            ]
          },
          "docs": "Lists plugin memberships and resolved config object projections."
        },
        {
          "info": {
            "name": "Add plugin config object",
            "type": "http"
