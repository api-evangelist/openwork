          "info": {
            "name": "List plugins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openworklabs.com/v1/plugins",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists plugins visible to the current organization member."
        },
        {
          "info": {
            "name": "Create plugin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openworklabs.com/v1/plugins",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
