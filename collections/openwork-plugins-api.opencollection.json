          "http": {
            "method": "POST",
            "url": "https://api.openworklabs.com/v1/plugins/:pluginId/config-objects",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "path",
                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
