          "http": {
            "method": "POST",
            "url": "https://api.openworklabs.com/v1/plugins/:pluginId/restore",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "path",
                "description": "Den TypeID with 'plg_' prefix and a 26-character base32 suffix."
              }
            ]
          },
          "docs": "restore a plugin without touching its historical memberships."
        },
        {
